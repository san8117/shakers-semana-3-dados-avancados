{{ 'metaobject-slider.css' | asset_url | stylesheet_tag }}
{{ 'metaobject-slider.js' | asset_url | script_tag }}

{% assign product_section = section.settings.products %}
{% assign product = all_products[product_section] %}

{% assign products_related = product.metafields.custom.list_banner_with_product.value %}

<section>
  <main>
    {% if products_related != blank %}
      <div class="swiper">
        <div class="swiper-wrapper">
          {% for products_slider in products_related %}
            <div class="swiper-slide">
              <img src="{{products_slider.banner |  image_url: width: 700 , height: 350}}"alt="{{products_slider.banner.alt}}"width=""height=""
              >
            </div>
          {% endfor %}
        </div>

        <div class="swiper-pagination"></div>

        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>

      {% for products_banner in products_related %}
        {% assign product_handle = products_banner.produto %}
        {% assign product_b_handle = all_products[product_handle] %}

        <a href="{{ product_b_handle.url}}">
          <img
            src="{{product_b_handle.featured_image |  image_url: width: 100, height: 100}}"
            alt="{{product_b_handle.featured_image.alt}}"
            width="300"
            height="300"
          >
          <h2>{{ product_b_handle.title }}</h2>
        </a>
      {% endfor %}
    {% endif %}
  </main>
</section>

{% schema %}
{
  "name": "metaobject-slider",
  "settings": [
    {
      "type": "product",
      "id": "products",
      "label": "Produto"
    }
  ],

  "presets": [
    {
      "name": "metaobject-slider"
    }
  ]
}
{% endschema %}
